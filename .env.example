# CipherGuard-AegisFusion public configuration template
# Copy to .env and edit local paths. Do not commit real credentials.

CIPHERGUARD_HOST=0.0.0.0
CIPHERGUARD_BACKEND_PORT=18080
CIPHERGUARD_FRONTEND_PORT=18081
AEGISFUSION_MODEL_PORT=18083

# Python executables
CIPHERGUARD_PYTHON=python3
AEGISFUSION_PYTHON=python3

# Project/model paths
AEGISFUSION_PROJECT=./runtime/aegisfusion_project
CIPHERGUARD_APP=./runtime/cipherguard_app
AEGISFUSION_DATA_DIR=./data/processed/tabular_v1
AEGISFUSION_BASE_MODEL_DIR=./models/hierarchical_full_v1
AEGISFUSION_TEMPORAL_MODEL_DIR=./models/temporal_infiltration_full_v1

# Optional runtime settings
CIPHERGUARD_MODEL_DEVICE=cpu
